<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_credit_note_return_wizard_form" model="ir.ui.view">
        <field name="name">l10n_gt_joyeria.credit_note_return_wizard.form</field>
        <field name="model">l10n_gt_joyeria.credit_note_return_wizard</field>
        <field name="arch" type="xml">
            <form string="Entregas relacionadas con la nota de crédito">
                <div class="alert alert-info" role="alert">
                    Abre cada entrega para revisar sus productos. Si marcas uno o más productos,
                    se devolverán solo esos; si no marcas ninguno, se devolverán todas las cantidades
                    pendientes de todos los productos listados. La devolución quedará pendiente de
                    validación y el inventario cambiará al validarla.
                </div>
                <field name="move_id" invisible="1"/>
                <field name="picking_line_ids" nolabel="1">
                    <list create="0" delete="0">
                        <field name="picking_id"/>
                        <field name="date_done"/>
                        <field name="origin" optional="hide"/>
                    </list>
                    <form string="Productos de la entrega">
                        <group>
                            <field name="picking_id"/>
                            <field name="date_done"/>
                            <field name="origin"/>
                        </group>
                        <field name="move_line_ids" nolabel="1">
                            <list create="0" delete="0" editable="bottom">
                                <field name="selected"/>
                                <field name="product_id"/>
                                <field name="quantity_available"/>
                                <field name="quantity_to_return"/>
                                <field name="uom_id"/>
                            </list>
                        </field>
                    </form>
                </field>
                <footer>
                    <button name="action_confirm_with_returns" string="Confirmar y crear devolución"
                            type="object" class="oe_highlight"/>
                    <button name="action_confirm_note_only" string="Solo confirmar nota"
                            type="object"/>
                    <button string="Cancelar" special="cancel" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
